---
import { Icon } from 'astro-icon/components';
import { meta, sources } from '~/data/wfe';

const updated = new Date(`${meta.updated}-01T00:00:00Z`).toLocaleString('en', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<section class="view" data-view="about" data-title="About & sources">
  <div class="view-head">
    <p class="view-eyebrow">About</p>
    <h1 class="view-title">About this hub</h1>
    <p class="view-lede">Dataset last reviewed {updated}.</p>
  </div>

  <div class="grid-2">
    <article class="card span-2">
      <div class="prose-app"><slot /></div>
    </article>

    <article class="card">
      <h2 class="card-title">Methodology</h2>
      <ul class="mt-3 grid gap-2 text-sm text-2">
        <li>
          WFE means front-end wafer processing equipment. Test, assembly and fab facilities are excluded unless noted.
        </li>
        <li>
          Regional figures are total semiconductor equipment billings by where tools ship, so they sum to more than WFE.
        </li>
        <li>
          Vendor revenue is the latest full fiscal year, including services, converted to USD at period-average rates.
        </li>
        <li>Segment sizes apply approximate shares to the latest actual WFE total.</li>
        <li>Fab status and timing follow company announcements and change often.</li>
      </ul>
      <div class="notice mt-4">
        <Icon name="tabler:alert-triangle" />
        <span>{meta.disclaimer}</span>
      </div>
    </article>

    <article class="card">
      <h2 class="card-title">Sources</h2>
      <ul class="mt-3 grid gap-2 text-sm">
        {
          sources.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-start gap-2 hover:text-[var(--app-primary)]"
              >
                <Icon
                  name="tabler:external-link"
                  class="shrink-0 mt-0.5 text-[var(--app-text-3)]"
                  width={16}
                  height={16}
                />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="card span-2">
      <h2 class="card-title">Data for AI assistants and developers</h2>
      <p class="text-sm text-2 mt-1">
        The whole dataset behind this hub is published in machine-readable form. Figures are the same approximations
        shown here, so the same caveats apply.
      </p>
      <ul class="mt-3 grid gap-2 text-sm">
        <li>
          <a href="/apps/wfe-intelligence-hub/llms.txt" class="underline">llms.txt</a>: a guide for LLMs and agents.
        </li>
        <li>
          <a href="/apps/wfe-intelligence-hub/llms-full.txt" class="underline">llms-full.txt</a>: every table as
          Markdown.
        </li>
        <li>
          <a href="/apps/wfe-intelligence-hub/data.json" class="underline">data.json</a>: the same data as JSON, with
          stable ids.
        </li>
      </ul>
    </article>

    <article class="card span-2">
      <div class="flex items-start gap-3">
        <span class="app-brand-mark" aria-hidden="true"
          ><Icon name="tabler:device-mobile" width={18} height={18} /></span
        >
        <div>
          <h2 class="card-title">Use it like an app</h2>
          <p class="text-sm text-2 mt-1">
            On a phone, open your browser’s share or menu button and choose <strong>Add to Home Screen</strong>. The hub
            opens full screen, without browser chrome. Press <kbd class="badge">/</kbd> or <kbd class="badge">⌘K</kbd> anywhere
            to search.
          </p>
        </div>
      </div>
    </article>
  </div>
</section>
