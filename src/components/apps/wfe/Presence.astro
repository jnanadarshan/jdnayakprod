---

<section class="view" data-view="presence" data-title="Presence">
  <div class="space-y-6 pv">
    <div class="view-head" style="margin-bottom:0">
      <h2 class="text-xl font-bold">Semiconductor Manufacturing Process Presence Map</h2>
      <p class="text-sm pv-muted-fg mt-1 max-w-3xl">
        Interactive mapping of WFE vendor dominance across the semiconductor manufacturing value chain.
      </p>
    </div>

    {/* Legend */}
    <div class="flex flex-wrap gap-3 items-center">
      {
        legend.map((l) => (
          <div class="flex items-center gap-1.5 text-xs pv-muted-fg">
            <span class={`inline-block h-2.5 w-2.5 rounded-sm ${l.cls}`} />
            {l.label}
          </div>
        ))
      }
    </div>

    {/* Value Chain */}
    <div class="pv-card">
      <div class="pv-card-header">
        <h3 class="text-base font-semibold leading-none tracking-tight">
          Semiconductor Manufacturing Process Value Chain
        </h3>
        <p class="text-xs pv-muted-fg">Front-End Wafer Fabrication Flow</p>
      </div>
      <div class="pv-card-content">
        <div class="overflow-x-auto pb-2">
          <div class="flex items-stretch min-w-[1100px]">
            {
              stages.map((stage, idx) => (
                <div class="flex items-stretch">
                  <div class:list={['pv-stage', stage.highlight && 'pv-stage-hl']}>
                    <div class="px-3 pt-3 pb-2 text-center">
                      <span class="text-2xl block mb-1">{stage.icon}</span>
                      <div class="text-[11px] font-bold leading-tight">{stage.name}</div>
                      <div class="text-[9px] pv-muted-fg mt-0.5">{stage.sub}</div>
                    </div>
                    <div class="px-2 pb-3 flex flex-wrap gap-1 justify-center">
                      {stage.pills.map((p) => (
                        <span class={p.cls}>{p.t}</span>
                      ))}
                    </div>
                  </div>
                  {idx < stages.length - 1 && (
                    <div class="flex items-center pv-arrow text-lg flex-shrink-0 -mx-1 z-10">→</div>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        {/* Cross-process band */}
        <div class="mt-6">
          <div class="text-[10px] font-bold uppercase tracking-widest pv-muted-fg-60 mb-3">
            ⤵ Cross-Process &amp; Inline Steps (used across all stages)
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 p-4 pv-band rounded-xl">
            {
              crossProcess.map((item) => (
                <div class="rounded-lg pv-mini p-3">
                  <div class="text-xs font-bold mb-1">
                    {item.icon} {item.title}
                  </div>
                  <div class="text-[10px] pv-muted-fg mb-2">{item.desc}</div>
                  <div class="flex flex-wrap gap-1">
                    {item.pills.map((p) => (
                      <span class={p.cls}>{p.t}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    {/* Heatmap + Chokepoints */}
    <div class="grid gap-6 lg:grid-cols-[1fr_340px]">
      <div class="pv-card min-w-0">
        <div class="pv-card-header">
          <h3 class="text-base font-semibold leading-none tracking-tight">Vendor × Process Presence Heatmap</h3>
          <p class="text-xs pv-muted-fg">Dominance mapping across semiconductor manufacturing processes</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[11px] pv-heatmap" style="min-width:900px">
            <thead>
              <tr>
                <th class="px-3 py-2 text-left text-[10px] font-bold uppercase tracking-wider min-w-[130px]">Vendor</th>
                {columns.map((col) => <th class="px-2 py-2 text-center text-[9px] font-bold uppercase">{col}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                heatmap.map((row) => (
                  <tr>
                    <td
                      class:list={['px-3 py-2', row.color ? 'font-semibold' : 'font-medium pv-muted-fg']}
                      style={row.color ? `color:${row.color}` : undefined}
                    >
                      {row.vendor}
                    </td>
                    {row.levels.map((lv) => (
                      <td class={`px-2 py-2 text-center text-[11px] pv-hm-${lv}`}>{cellText[lv]}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      {/* Critical Chokepoints */}
      <div class="space-y-3">
        <div>
          <h3 class="text-base font-semibold">Critical Chokepoints</h3>
          <p class="text-xs pv-muted-fg">Single-vendor dominant processes</p>
        </div>
        {
          chokepoints.map((item) => (
            <div class={`rounded-lg pv-choke ${item.accent} p-4`}>
              <div class="text-sm font-bold mb-1">{item.title}</div>
              <div class="text-xs pv-muted-fg mb-2">{item.desc}</div>
              <span class={PILL_DOM}>{item.pill}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* nanovision shadcn tokens → app tokens */
  .pv {
    --pv-primary: var(--app-text-1);
    --pv-accent: hsl(217 91% 60%);
    --pv-muted: var(--app-surface-2);
    --pv-muted-fg: var(--app-text-2);
    --pv-border: var(--app-border);
    --pv-card: var(--app-surface);
    --pv-bg: var(--app-bg);
  }
  .pv-muted-fg {
    color: var(--pv-muted-fg);
  }
  .pv-muted-fg-60 {
    color: color-mix(in srgb, var(--pv-muted-fg) 60%, transparent);
  }
  .pv-arrow {
    color: color-mix(in srgb, var(--pv-muted-fg) 40%, transparent);
  }
  .pv-card {
    border-radius: 0.5rem;
    border: 1px solid var(--pv-border);
    background: var(--pv-card);
    box-shadow: 0 1px 2px rgb(0 0 0 / 5%);
  }
  .pv-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.5rem 1.5rem 0.5rem;
  }
  .pv-card-content {
    padding: 0 1.5rem 1.5rem;
  }
  .pv-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-size: 9px;
    border: 1px solid;
  }
  .pv-pill-dom {
    font-weight: 700;
    background: color-mix(in srgb, var(--pv-primary) 20%, transparent);
    color: var(--pv-primary);
    border-color: color-mix(in srgb, var(--pv-primary) 30%, transparent);
  }
  .pv-pill-str {
    font-weight: 700;
    background: color-mix(in srgb, var(--pv-accent) 15%, transparent);
    color: var(--pv-accent);
    border-color: color-mix(in srgb, var(--pv-accent) 25%, transparent);
  }
  .pv-pill-pres {
    font-weight: 500;
    background: color-mix(in srgb, var(--pv-muted) 30%, transparent);
    color: var(--pv-muted-fg);
    border-color: var(--pv-border);
  }
  .pv-legend-dom {
    background: color-mix(in srgb, var(--pv-primary) 50%, transparent);
  }
  .pv-legend-pres {
    background: color-mix(in srgb, var(--pv-muted) 60%, transparent);
    border: 1px solid var(--pv-border);
  }
  .pv-stage {
    flex: 1;
    width: 120px;
    margin: 0 0.25rem;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--pv-border);
    background: linear-gradient(to bottom, var(--pv-card), var(--pv-bg));
    transition: all 0.2s;
  }
  .pv-stage:hover {
    transform: translateY(-0.25rem);
    border-color: var(--pv-primary);
  }
  .pv-stage-hl {
    border-color: color-mix(in srgb, var(--pv-primary) 30%, transparent);
    background: linear-gradient(to bottom, color-mix(in srgb, var(--pv-primary) 5%, transparent), var(--pv-bg));
  }
  .pv-band {
    border: 2px dashed var(--pv-border);
    background: color-mix(in srgb, var(--pv-muted) 20%, transparent);
  }
  .pv-mini {
    border: 1px solid var(--pv-border);
    background: var(--pv-card);
    transition: border-color 0.15s;
  }
  .pv-mini:hover {
    border-color: var(--pv-primary);
  }
  .pv-heatmap th,
  .pv-heatmap td {
    border: 1px solid var(--pv-border);
  }
  .pv-heatmap th {
    color: var(--pv-muted-fg);
    background: color-mix(in srgb, var(--pv-muted) 30%, transparent);
  }
  .pv-heatmap tbody tr:hover {
    background: color-mix(in srgb, var(--pv-muted) 30%, transparent);
  }
  .pv-hm-dom {
    background: color-mix(in srgb, var(--pv-primary) 20%, transparent);
    color: var(--pv-primary);
    font-weight: 700;
  }
  .pv-hm-str {
    background: color-mix(in srgb, var(--pv-accent) 10%, transparent);
    color: var(--pv-accent);
    font-weight: 600;
  }
  .pv-hm-mod {
    background: var(--pv-muted);
    color: var(--pv-muted-fg);
  }
  .pv-hm-low {
    background: color-mix(in srgb, var(--pv-muted) 20%, transparent);
    color: color-mix(in srgb, var(--pv-muted-fg) 60%, transparent);
  }
  .pv-hm-none {
    color: color-mix(in srgb, var(--pv-muted-fg) 30%, transparent);
  }
  .pv-choke {
    border: 1px solid var(--pv-border);
    border-left-width: 4px;
    background: var(--pv-card);
  }
  .pv-accent-primary {
    border-left-color: var(--pv-primary);
  }
  /* Tailwind blue-400 / blue-300 / indigo-600 */
  .pv-accent-blue-400 {
    border-left-color: #60a5fa;
  }
  .pv-accent-blue-300 {
    border-left-color: #93c5fd;
  }
  .pv-accent-indigo-600 {
    border-left-color: #4f46e5;
  }
</style>
