---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Image from '~/components/common/Image.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Demos',
  description: 'Interactive MES simulators and 3D semiconductor process simulations.',
};

const demos = (await getCollection('demos', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(demos.map(async (d) => ({ d, image: await findImage(d.data.image) })));
const labels = { mes: 'MES', '3d': '3D simulation', other: 'Demo' };
---

<Layout metadata={metadata}>
  <HeroText tagline="Demos" title="Simulators and simulations">
    <Fragment slot="subtitle">Interactive MES simulators and 3D semiconductor process simulations.</Fragment>
  </HeroText>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-16">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map(({ d, image }) => (
          <a href={getPermalink(`/demos/${d.slug}`)} class="block group">
            {image && typeof image !== 'string' && (
              <Image src={image} alt={d.data.title} class="w-full h-auto rounded mb-4" widths={[400, 800]} sizes="400px" />
            )}
            <p class="text-sm text-muted">{labels[d.data.type]} · {d.data.status}</p>
            <h2 class="text-xl font-bold group-hover:underline">{d.data.title}</h2>
            <p class="mt-1">{d.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
