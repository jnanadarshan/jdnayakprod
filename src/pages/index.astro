---
import { themedImage } from '~/utils/themed-image';
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import waferLight from '~/assets/images/wafer-hero-light.svg';
import waferDark from '~/assets/images/wafer-hero-dark.svg';

const metadata = {
  title: 'Jnanadarshan Nayak | JDNayak.com',
  description:
    'JD Nayak: Head of Semiconductor Strategy & Semiconductor Manufacturing Practice at TCS. Agentic AI for fabs, 3D semiconductor simulators, open source tools, homelab and DIY projects.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Semiconductor Manufacturing × Agentic AI"
    actions={[
      { variant: 'primary', text: 'AI × Semiconductor', href: '/ai-semiconductor', icon: 'tabler:cpu' },
      { text: 'About me', href: '/about' },
    ]}
  >
    <Fragment slot="image">
      <img
        src={waferLight.src}
        width={waferLight.width}
        height={waferLight.height}
        alt="A 300 mm silicon wafer with one die lifted out and connected to AI agents"
        class="mx-auto w-full dark:hidden"
        loading="eager"
      />
      <img
        src={waferDark.src}
        width={waferDark.width}
        height={waferDark.height}
        alt="A 300 mm silicon wafer with one die lifted out and connected to AI agents"
        class="mx-auto w-full hidden dark:block"
        loading="eager"
      />
    </Fragment>
    <Fragment slot="title">
      I help Semiconductor FABs go from <br class="hidden md:inline" />
      <span class="text-accent dark:text-white highlight">Autonomous to Agentic</span>
    </Fragment>
    <Fragment slot="subtitle">
      I'm Jnanadarshan (JD) Nayak. I head Semiconductor Strategy &amp; the Semiconductor Manufacturing Practice at TCS. I design how AI, and increasingly
      agentic AI, gets infused into fab operations. Outside client work I build software, simulators and educational
      tools, contribute to open source, run a self-hosted homelab, and design and print my own hardware.
    </Fragment>
  </Hero>

  <Features
    id="focus"
    tagline="Focus areas"
    title="Where fab domain expertise meets agentic AI engineering"
    subtitle="The next productivity step in manufacturing will not come from more dashboards. It will come from systems that perceive, reason and act inside the production environment, with engineers supervising rather than operating."
    columns={3}
    items={[
      {
        title: 'AI × Semiconductor',
        description:
          'Virtual metrology, defect root-cause analysis, trace data FDC, chamber matching and MES-integrated automation, grounded in real process and equipment knowledge.',
        icon: 'tabler:cpu',
        callToAction: { text: 'Explore the focus area', href: '/ai-semiconductor' },
      },
      {
        title: 'Agentic AI at scale',
        description:
          'Making agent systems trustworthy, governable and repeatable enough to proliferate across a factory and an enterprise, with autonomy that is earned, not declared.',
        icon: 'tabler:robot',
        callToAction: { text: 'Read the thesis', href: '/agentic-ai' },
      },
      {
        title: 'Software builder',
        description:
          'Simulators, dashboards, agents and data pipelines. Small, sharp tools that work in a browser or a terminal and can be understood in an afternoon.',
        icon: 'tabler:code',
        callToAction: { text: 'See the projects', href: '/projects' },
      },
    ]}
  />

  <Steps
    image={themedImage('autonomy-stages', 'Four-stage staircase of progressive autonomy')}
    title="How agentic AI reaches the factory floor"
    subtitle="Autonomy is staged. Each step has its own evidence, thresholds and approvals before the next one begins."
    items={[
      {
        title: 'Advise',
        description: 'The agent investigates and explains. Engineers decide and act.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Recommend with approval',
        description: 'The agent proposes a specific action. A human approves it at a defined gate.',
        icon: 'tabler:checklist',
      },
      {
        title: 'Act within bounds',
        description: 'The agent acts inside explicit limits, with confidence thresholds and rollback paths.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Act and report',
        description: 'The agent owns a bounded task end to end. Humans supervise exceptions and set policy.',
        icon: 'tabler:report',
      },
    ]}
  />

  <Features3
    id="more"
    tagline="Beyond client work"
    title="Where I build, host and make"
    subtitle="Most of what I advise on, I have first prototyped myself."
    columns={3}
    items={[
      {
        title: 'Open source',
        description: 'Fixes, documentation and small tools that solve a problem someone else will hit next.',
        icon: 'tabler:brand-github',
        callToAction: { text: 'Open source', href: '/open-source' },
      },
      {
        title: 'Homelab',
        description:
          'A small production environment I am allowed to break: virtualisation, storage, segmented networking, security monitoring and home automation.',
        icon: 'tabler:server',
        callToAction: { text: 'Homelab', href: '/homelab' },
      },
      {
        title: 'DIY and making',
        description: 'Parametric design in OpenSCAD, 3D printing, embedded devices and hardware hacking.',
        icon: 'tabler:printer',
        callToAction: { text: 'DIY and making', href: '/diy' },
      },
    ]}
  />

  <BlogLatestPosts
    title="Latest from the blog"
    information="Notes on AI in the fab, agent architecture, open source tooling and the homelab. Every fix gets written down."
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Get in touch', href: '/contact', icon: 'tabler:mail' }]}
  >
    <Fragment slot="title">Working on AI for manufacturing?</Fragment>
    <Fragment slot="subtitle">
      I'm happy to talk about fab automation, agentic AI architecture and MES modernisation.
    </Fragment>
  </CallToAction>
</Layout>
