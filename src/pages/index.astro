---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Jnanadarshan Nayak',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'About me',
        href: '/about',
        icon: 'tabler:user',
      },
      { text: 'Read the blog', href: '/blog' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Jnanadarshan Nayak' }}
  >
    <Fragment slot="title">
      Hi, I'm Jnanadarshan Nayak —
      <span class="text-accent dark:text-white highlight"> semiconductor consultant</span>
    </Fragment>

    <Fragment slot="subtitle">
      I help semiconductor manufacturers turn technology into business outcomes — bridging
      <span class="font-semibold">IT, business development, and the practical adoption of AI</span>
      on the factory floor. Off the clock, I'm usually tinkering with smart-home gadgets and learning something new.
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="focus"
    tagline="What I do"
    title="Where I focus"
    subtitle="Helping semiconductor organizations connect strategy, technology, and execution."
    items={[
      {
        title: 'AI Adoption in Manufacturing',
        description:
          'Identifying high-value use cases for AI and machine learning across semiconductor fabs — from yield and quality to predictive maintenance — and turning pilots into production.',
        icon: 'tabler:cpu',
      },
      {
        title: 'IT Business Development',
        description:
          'Aligning IT capabilities with business goals: shaping technology roadmaps, building partnerships, and making the case for investments that move the needle.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Bridging Tech & Business',
        description:
          'Translating between engineering, IT, and leadership so the right problems get solved and good ideas actually ship.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Digital Transformation',
        description:
          'Modernizing data, tooling, and workflows in complex manufacturing environments where reliability and uptime are non-negotiable.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Beyond work"
    title="Tinkering, DIY & smart homes"
    items={[
      {
        title: 'Smart homes',
        description:
          'Automating the everyday — building reliable, privacy-respecting home automation that quietly does its job.',
      },
      {
        title: 'DIY & tinkering',
        description:
          'Taking things apart, putting them back together (mostly), and learning how they really work along the way.',
      },
      {
        title: 'Always learning',
        description:
          'Picking up new skills, tools, and ideas — and writing down what I learn so it sticks.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Workbench with tools and electronics',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Curiosity, applied</h3>
      The same instinct that makes me a good consultant — figuring out how systems fit together — is what I enjoy most
      in my free time.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- BlogLatestPosts Widget ******** -->

  <BlogLatestPosts
    title="From the blog"
    information={`Notes on technology, AI in manufacturing, smart-home projects, and whatever I'm currently learning.`}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get in touch',
        href: '/about',
        icon: 'tabler:message',
      },
    ]}
  >
    <Fragment slot="title">Let's connect</Fragment>

    <Fragment slot="subtitle">
      Interested in AI adoption, IT strategy in semiconductor manufacturing, or just want to talk shop? Find me on the
      links below.
    </Fragment>
  </CallToAction>
</Layout>
