---
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About"
    image={{
      src: 'https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Circuit board close-up',
    }}
  >
    <Fragment slot="title">
      A consultant at the intersection of <br />
      <span class="text-accent dark:text-white highlight"> chips, IT, and AI</span>
    </Fragment>

    <Fragment slot="subtitle">
      I'm Jnanadarshan Nayak. I work with semiconductor manufacturers on IT business development and the practical
      adoption of AI — helping teams move from interesting ideas to results that hold up on the factory floor. I care
      about clarity, reliability, and solving the problem that actually matters.
    </Fragment>
  </Hero>

  <!-- Features3 Widget ************** -->

  <Features3
    title="What I bring"
    subtitle="A mix of business sense, technical depth, and a bias toward getting things done."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'AI & ML adoption',
        description:
          'Spotting where AI genuinely helps in manufacturing — and where it does not — then guiding pilots through to production.',
        icon: 'tabler:cpu',
      },
      {
        title: 'IT business development',
        description:
          'Connecting technology investments to business outcomes, building partnerships, and making roadmaps that survive contact with reality.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Translation & alignment',
        description:
          'Speaking both engineering and business fluently, so the right people are working on the right problems.',
        icon: 'tabler:messages',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="How I work"
    subtitle="A few principles I keep coming back to."
    items={[
      {
        title: 'Start with the problem',
        description:
          'Technology is a means, not an end. I dig into what is actually slowing a team down before reaching for a solution.',
      },
      {
        title: 'Keep it reliable',
        description:
          'In manufacturing, uptime and trust matter more than novelty. I favor solutions that are robust and maintainable.',
      },
      {
        title: 'Make it stick',
        description:
          'A successful project is one people keep using. I focus on adoption, documentation, and handover — not just delivery.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Outside of work"
    subtitle="Where my curiosity goes when the laptop closes."
    isReversed={true}
    items={[
      {
        title: 'Smart homes',
        description:
          'Building automation that is reliable and privacy-respecting — the kind that quietly works without anyone thinking about it.',
        icon: 'tabler:home-bolt',
      },
      {
        title: 'DIY & tinkering',
        description:
          'Hands-on projects, electronics, and the occasional repair. I learn best by taking things apart.',
        icon: 'tabler:tool',
      },
      {
        title: 'Learning new skills',
        description:
          'There is always something new worth understanding. I like picking up skills and writing about what I learn.',
        icon: 'tabler:bulb',
      },
    ]}
  />
</Layout>
