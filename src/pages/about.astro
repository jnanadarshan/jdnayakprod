---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About',
  description:
    'Jnanadarshan (JD) Nayak heads Semiconductor Strategy & the Semiconductor Manufacturing Practice at TCS, based in Bhubaneswar, India, working on agentic AI for fab operations.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="About" title="Jnanadarshan Nayak" subtitle="Goes by JD Nayak. Based in Bhubaneswar, Odisha, India." />

  <Content
    image={{ src: '~/assets/images/wafer-hero.svg', alt: 'A silicon wafer with a grid of dies' }}
    isReversed={false}
    tagline="Bio" title="Where semiconductor manufacturing meets modern AI">
    <Fragment slot="content">
      <p class="mb-4">
        Jnanadarshan (JD) Nayak works at the point where semiconductor manufacturing meets modern AI. He heads
        Semiconductor Strategy &amp; the Semiconductor Manufacturing Practice at Tata Consultancy Services, and has
        been with TCS in the Hi-Tech domain since August 2017. He advises semiconductor and electronics manufacturers
        on AI adoption, fab automation, MES/MOM modernisation, IT/OT convergence and competitive strategy, working
        primarily with companies in the US and Europe, and increasingly across Asia Pacific.
      </p>
      <p class="mb-4">
        His conviction is simple: the next productivity step in manufacturing will not come from more dashboards. It
        will come from systems that perceive, reason and act inside the production environment, with engineers
        supervising rather than operating. He designs those systems end to end: the domain knowledge layer, the agent
        orchestration, the human-in-the-loop controls, the standards-compliant integration, and the phased path to
        autonomy.
      </p>
      <p>
        He is equally a builder. He writes software in Go, Python and Node.js, creates interactive 3D and browser-based
        learning tools for semiconductor processes, contributes to and publishes open source, and runs a self-hosted
        homelab covering storage, virtualisation, network security and home automation. When something physical is
        needed, he designs it in OpenSCAD and prints it.
      </p>
    </Fragment>
  </Content>

  <Features3
    tagline="What I do"
    title="Five pillars"
    columns={3}
    items={[
      {
        title: 'AI × Semiconductor',
        description:
          'Designing and delivering AI and agentic systems for fab operations, grounded in real process and equipment knowledge.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Agentic AI at scale',
        description:
          'Making agent systems trustworthy, governable and repeatable enough to proliferate across a factory and an enterprise.',
        icon: 'tabler:robot',
      },
      {
        title: 'Software and open source',
        description: 'Building tools, simulators and platforms, and sharing what works.',
        icon: 'tabler:code',
      },
      {
        title: 'Homelab',
        description:
          'Self-hosted infrastructure, network security and automation, run like a small production environment.',
        icon: 'tabler:server',
      },
      {
        title: 'DIY and making',
        description: 'Parametric design, 3D printing, embedded devices and hardware hacking.',
        icon: 'tabler:tool',
      },
    ]}
  />

  <Content isReversed={true} tagline="How I work" title="Practitioner first">
    <Fragment slot="content">
      <ul class="list-disc pl-5 space-y-2">
        <li>I lead with what was built and what it solved.</li>
        <li>I name the standards, tools and methods instead of waving at them.</li>
        <li>I have calm confidence on AI: no hype, but clear conviction on direction.</li>
        <li>I build to understand. Most of what I advise on, I have first prototyped myself.</li>
        <li>Every fix gets written down, ideally somewhere other people can find it.</li>
      </ul>
    </Fragment>
  </Content>

  <Content tagline="Independent work" title="Personal projects are personal">
    <Fragment slot="content">
      <p>
        The projects, simulators, homelab notes and opinions on this site are my own. They are independent of my
        employer and its clients, and nothing here describes client engagements, proprietary designs or internal
        systems. Views expressed here are my own and do not represent those of my employer or its clients.
      </p>
    </Fragment>
  </Content>

  <CallToAction actions={[{ variant: 'primary', text: 'Contact me', href: '/contact', icon: 'tabler:mail' }]}>
    <Fragment slot="title">Let's talk</Fragment>
    <Fragment slot="subtitle">Fab automation, agentic AI architecture, MES modernisation or open source tooling.</Fragment>
  </CallToAction>
</Layout>
