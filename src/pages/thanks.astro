---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = { title: 'Message sent', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Thank you"
    title="Message sent"
    subtitle="Thanks for getting in touch. I will reply as soon as I can."
    callToAction={{ text: 'Back to home', href: '/' }}
  />
</Layout>
