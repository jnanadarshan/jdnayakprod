---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
  description: 'Get in touch with JD Nayak about agentic AI for semiconductor fabs, MES modernisation, open source or homelab topics.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Contact" title="Let's connect" />

  <ContactUs
    id="form"
    title="Send me a message"
    subtitle="Tell me a little about what you are working on and I will get back to you."
    inputs={[
      { type: 'text', name: 'name', label: 'Name' },
      { type: 'email', name: 'email', label: 'Email' },
    ]}
    textarea={{ label: 'Message' }}
    disclaimer={{
      label: 'I will use your details only to reply to this message.',
    }}
    description="I read every message and reply as soon as I can."
  />

  <Features2
    title="What I am happy to talk about"
    items={[
      {
        title: 'AI in the fab',
        description: 'Virtual metrology, defect root-cause analysis, FDC, chamber matching and staged autonomy.',
        icon: 'tabler:cpu',
      },
      {
        title: 'MES/MOM and integration',
        description: 'MES modernisation, SEMI standards, IT/OT convergence and federated integration.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Open source and tools',
        description: 'Simulators, learning tools, agent architectures and community write-ups.',
        icon: 'tabler:brand-github',
      },
    ]}
  />
</Layout>
